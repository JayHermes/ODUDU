# Tidepool is a community-built NEAR Intents testnet sandbox.
# Set this to the API base URL published in the current Tidepool docs.
# Mainnet 1Click endpoints are rejected by the quote client.
NEAR_INTENTS_API_BASE_URL=

# Neon Managed Better Auth and PostgreSQL (set in Vercel and local .env.local)
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
NEON_AUTH_JWKS_URL=
